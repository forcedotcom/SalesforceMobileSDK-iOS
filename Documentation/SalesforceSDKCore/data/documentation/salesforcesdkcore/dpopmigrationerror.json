{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPMigrationError"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DPoPMigrationError","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"New logins are DPoP-bound by default, but users who logged in with an earlier SDK version (or"},{"type":"text","text":" "},{"type":"text","text":"with DPoP disabled) keep a Bearer refresh token until the app migrates it. The SDK primitive is"},{"type":"text","text":" "},{"type":"codeVoice","code":"UserAccountManager.upgradeToDPoP(_:success:failure:)"},{"type":"text","text":"; this class adds the “when and how”:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It is a no-op when there is no current user or the credentials are already DPoP-bound. The"},{"type":"text","text":" "},{"type":"text","text":"credentials’ token type is the only source of truth; no state is persisted."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"At most one upgrade is in flight. Callers for the same user arriving meanwhile are queued and"},{"type":"text","text":" "},{"type":"text","text":"completed together with the same outcome. A caller whose current user differs from the one"},{"type":"text","text":" "},{"type":"text","text":"being upgraded gets "},{"type":"codeVoice","code":".failed(DPoPMigrationError.anotherMigrationInProgress)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An upgrade abandoned through "},{"type":"codeVoice","code":"UserAccountManager.stopCurrentAuthentication"},{"type":"text","text":" completes with"},{"type":"text","text":" "},{"type":"codeVoice","code":".failed(DPoPMigrationError.cancelled)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On failure nothing is persisted and the existing session is left intact, so the next call"},{"type":"text","text":" "},{"type":"text","text":"(typically the next launch) retries. There is no automatic retry and no logout."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The upgrade may present the SDK’s web-based approve\/deny screen. This class has no UI of its"},{"type":"text","text":" "},{"type":"text","text":"own: the app decides when to call it and what to show while it runs."}],"type":"paragraph"},{"code":["switch await DPoPMigrationManager.shared.migrateIfNeeded() {","case .notNeeded, .migrated: break","case .failed(let error): print(\"Not migrated: \\(error)\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Why a migration did not complete. Reported through "},{"type":"codeVoice","code":"DPoPMigrationManager.Outcome.failed"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/salesforcesdkcore\/dpopmigrationerror"]}],"metadata":{"symbolKind":"enum","title":"DPoPMigrationError","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"DPoPMigrationError"}],"externalID":"s:17SalesforceSDKCore18DPoPMigrationErrorO","modules":[{"name":"SalesforceSDKCore"}],"role":"symbol","roleHeading":"Enumeration","navigatorTitle":[{"text":"DPoPMigrationError","kind":"identifier"}]},"relationshipsSections":[{"identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/SQ","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s5ErrorP","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/SH","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s8SendableP","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore"]]},"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPMigrationError\/anotherMigrationInProgress","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPMigrationError\/cancelled","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPMigrationError\/notDPoPBound"],"anchor":"Enumeration-Cases","generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPMigrationError\/Equatable-Implementations","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPMigrationError\/Error-Implementations"],"generated":true}],"kind":"symbol","sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Headless helper that upgrades the current user’s session from a Bearer (non-DPoP) refresh"},{"type":"text","text":" "},{"type":"text","text":"token to a DPoP-bound one."}],"references":{"doc://com.salesforce.mobilesdk.SalesforceSDKCore/s5ErrorP":{"title":"Swift.Error","type":"unresolvable","identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s5ErrorP"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s8SendableP"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/SQ":{"identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/documentation/Salesf