,"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"NB: SFUserAccountManager stores the consumer key, callback URL, etc. in its shared","type":"text"},{"text":" ","type":"text"},{"text":"instance, backed by shared prefs and initialized from the static boot config.","type":"text"},{"text":" ","type":"text"},{"text":"Previously, the app always used these shared instance values for login.","type":"text"},{"text":" ","type":"text"},{"text":"Now, the app can inject alternate values instead — in that case, the shared","type":"text"},{"text":" ","type":"text"},{"text":"instance and prefs are left untouched (not read or overwritten).","type":"text"},{"text":" ","type":"text"},{"text":"The consumer key and related values used for login are saved in the user","type":"text"},{"text":" ","type":"text"},{"text":"account credentials (as before) and therefore used later for token refresh.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/SalesforceManager\/bootConfigRuntimeSelector"},"kind":"symbol","references":{"doc://com.salesforce.mobilesdk.SalesforceSDKCore/documentation/SalesforceSDKCore/BootConfigRuntimeSelector":{"title":"BootConfigRuntimeSelector","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"BootConfigRuntimeSelector"}],"url":"\/documentation\/salesforcesdkcore\/bootconfigruntimeselector","abstract":[{"type":"text","text":"Block to select an app config at runtime based on the login host."},{"type":"text","text":" "},{"type":"text","text":"The block takes a login host and a callback. The callback should be invoked with the selected app config."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"BootConfigRuntimeSelector"}],"role":"symbol","identifier":"doc:\/\/com.salesforce.mo