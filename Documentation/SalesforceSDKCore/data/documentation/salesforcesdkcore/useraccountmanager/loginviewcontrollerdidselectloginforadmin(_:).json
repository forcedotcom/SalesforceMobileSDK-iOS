{"deprecationSummary":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deprecated in Salesforce Mobile SDK 13.2.1 and will be removed in Salesforce Mobile SDK 14.0. Will be removed in 14.0 when a permanent solution is provided."}]}],"variants":[{"paths":["\/documentation\/salesforcesdkcore\/useraccountmanager\/loginviewcontrollerdidselectloginforadmin(_:)"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/salesforcesdkcore\/useraccountmanager\/loginviewcontrollerdidselectloginforadmin(_:)"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"type":"text","text":"Triggers the “Login for Admin” flow for the active login session associated with the given"},{"type":"text","text":" "},{"type":"text","text":"login view controller. Forces browser-based (advanced) authentication via ASWebAuthenticationSession,"},{"type":"text","text":" "},{"type":"text","text":"regardless of org configuration, to support phishing-resistant MFA."}],"metadata":{"modules":[{"name":"SalesforceSDKCore"}],"roleHeading":"Instance Method","platforms":[],"symbolKind":"method","role":"symbol","title":"loginViewControllerDidSelectLoginForAdmin(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"loginViewControllerDidSelectLoginForAdmin","kind":"identifier"},{"text":"(","kind":"text"},{"text":"SalesforceLoginViewController","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)SFLoginViewController"},{"text":")","kind":"text"}],"navigatorTitle":[{"text":"- ","kind":"text"},{"text":"loginViewControllerDidSelectLoginForAdmin:","kind":"identifier"}],"externalID":"c:objc(cs)SFUserAccountManager(im)loginViewControllerDidSelectLoginForAdmin:"},"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/UserAccountManager"]]},"identifier":{"