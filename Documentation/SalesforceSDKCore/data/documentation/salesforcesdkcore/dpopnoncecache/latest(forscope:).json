{"hierarchy":{"paths":[["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache"]]},"sections":[],"abstract":[{"text":"Returns the most recently observed nonce for ","type":"text"},{"type":"codeVoice","code":"scope"},{"text":", regardless of ","type":"text"},{"type":"codeVoice","code":"htu"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":"(latestForScope:) "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"latest"},{"kind":"text","text":"("},{"kind":"externalParam","text":"forScope"},{"kind":"text","text":" "},{"kind":"internalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?) -> "},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"RFC 9449 §8\/§9 leaves it to the authorization server to decide whether resource"},{"type":"text","text":" "},{"type":"text","text":"servers also emit "},{"code":"DPoP-Nonce","type":"codeVoice"},{"text":". Salesforce’s deployment seeds the nonce only on","type":"text"},{"type":"text","text":" "},{"text":"token-endpoint responses; resource-server responses do not refresh it. Clients","type":"text"},{"type":"text","text":" "},{"type":"text","text":"are expected to reuse that token-endpoint nonce on every DPoP-protected call for"},{"type":"text","text":" "},{"type":"text","text":"the lifetime of the DPoP session, and re-authenticate (which mints a fresh nonce)"},{"type":"text","text":" "},{"type":"text","text":"w