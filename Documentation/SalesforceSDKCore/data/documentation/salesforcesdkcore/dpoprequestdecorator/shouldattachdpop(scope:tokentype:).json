{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPRequestDecorator\/shouldAttachDPoP(scope:tokenType:)"},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPRequestDecorator"]]},"abstract":[{"type":"text","text":"Gate deciding whether to attach a DPoP proof for "},{"code":"scope","type":"codeVoice"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":"(shouldAttachDPoPForScope:tokenType:) "},{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shouldAttachDPoP"},{"kind":"text","text":"("},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tokenType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"An explicit "},{"type":"codeVoice","code":"tokenType"},{"type":"text","text":" is authoritative:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"tokenType == \"DPoP\""},{"type":"text","text":" (case-insensitive, per RFC 6749 §5.1 \/ RFC 9449 §6.1) → attach."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"any other known type (e.g. "},{"type":"codeVoice","code":"\"Bearer\""},{"type":"text","text":") → do "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" attach, and short-circuit"},{"type":"text","text":" "},{"type":"text","text":"before any Keychain I\/O. This is what protects the DPoP→Bearer migration \/"},{"text":" ","type":"text"},{"type":"text","text":"Bearer re-auth path: a Bearer credential that reuses a scope still holding stale"},{"text":" ","type":"text"},{"type":"text","text":"DPoP key material must never get an unexpected proof."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"tokenType == nil"},{"text":" is the transition window between ","type":"text"},{"code":"\/authorize","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"\/token"},{"type":"text","text":" "},{"type":"text","text":"(and any refresh where the persisted "},{"type":"codeVoice","code":"tokenType"},{"type":"text","text":" hasn’t been rehydrated onto the"},{"type":"text","text":" "},{"type":"text","text":"request struct yet). Only then do we fall back to the key-material signal: a DPoP"},{"type":"text","text":" "},{"type":"text","text":"keypair already persisted for this scope in the Keychain."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Empty scope always returns "},{"type":"codeVoice","code":"false"},{"type":"text","text":" — an empty "},{"type":"codeVoice","code":"SFOAuthCredentials.identifier"},{"type":"text","text":" "},{"type":"text","text":"would collide with unrelated accounts’ key material."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note: this gate is deliberately independent of "},{"type":"codeVoice","code":"SalesforceManager.shared.usesDPoP"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The global flag governs "},{"inlineContent":[{"text":"new","type":"text"}],"type":"emphasis"},{"type":"text","text":" logins (whether to request DPoP-bound tokens); once a"},{"type":"text","text":" "},{"type":"text","text":"credential is bound, every request for it carries a proof regardless of the flag."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/salesforcesdkcore\/dpoprequestdecorator\/shouldattachdpop(scope:tokentype:)"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/salesforcesdkcore\/dpoprequestdecorator\/shouldattachdpop(scope:tokentype:)"]}],"metadata":{"externalID":"c:@M@SalesforceSDKCore@objc(cs)SFSDKDPoPRequestDecorator(cm)shouldAttachDPoPForScope:tokenType:","symbolKind":"method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shouldAttachDPoP","kind":"identifier"},{"text":"(","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"tokenType","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"modules":[{"name":"SalesforceSDKCore"}],"roleHeading":"Type Method","navigatorTitle":[{"kind":"text","text":"+ "},{"text":"shouldAttachDPoPForScope:tokenType:","kind":"identifier"}],"role":"symbol","title":"shouldAttachDPoP(scope:tokenType:)"},"references":{"doc://com.salesforce.mobilesdk.SalesforceSDKCore/documentation/SalesforceSDKCore/DPoPRequestDecorator":{"title":"DPoPRequestDecorator","url":"\/documentation\/salesforcesdkcore\/dpoprequestdecorator","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DPoPRequestDecorator"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DPoPRequestDecor