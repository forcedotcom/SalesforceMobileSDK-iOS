ations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":"(shouldAttachDPoPForScope:tokenType:) "},{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shouldAttachDPoP"},{"kind":"text","text":"("},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tokenType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An explicit "},{"code":"tokenType","type":"codeVoice"},{"type":"text","text":" is authoritative:"}]},{"items":[{"content":[{"inlineContent":[{"code":"tokenType == \"DPoP\"","type":"codeVoice"},{"text":" (case-insensitive, per RFC 6749 §5.1 \/ RFC 9449 §6.1) → attach.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"any other known type (e.g. ","type":"text"},{"code":"\"Bearer\"","type":"codeVoice"},{"text":") → do ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" attach, and short-circuit","type":"text"},{"text":" ","type":"text"},{"text":"before any Keychain I\/O. This is what protects the DPoP→Bearer migration \/","type":"text"},{"text":" ","type":"text"},{"text":"Bearer re-auth path: a Bearer credential that reuses a scope still holding stale","type":"text"},{"text":" ","type":"text"},{"text":"DPoP key material must never get an unexpected proof.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":