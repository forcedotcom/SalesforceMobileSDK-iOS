{"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":"(shouldAttachDPoPForScope:tokenType:) ","kind":"text"},{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shouldAttachDPoP","kind":"identifier"},{"text":"(","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tokenType","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?) -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"An explicit ","type":"text"},{"type":"codeVoice","code":"tokenType"},{"text":" is authoritative:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"tokenType == \"DPoP\"","type":"codeVoice"},{"text":" (case-insensitive, per RFC 6749 §5.1 \/ RFC 9449 §6.1) → attach.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"any other known type (e.g. ","type":"text"},{"code":"\"Bearer\"","type":"codeVoice"},{"text":") → do ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" attach, and short-circuit","type":"text"},{"text":" ","type":"text"},{"text":"before any Keychain I\/O. This is what protects the DPoP→Bearer migration \/","type":"text"},{"text":" ","type":"text"},{"text":"Bearer re-auth path: a Bearer credential that reuses a scope still holding stale","type":"text"},{"text":" ","type":"text"},{"text":"DPoP key material must never get an unexpected proof.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"tokenType == nil","type":"codeVoice"},{"text":" is the transition window between ","type":"text"},{"code":"\/authorize","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"\/token","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(and any refresh where the persisted ","type":"text"},{"code":"tokenType","type":"codeVoice"},{"type":"text","text":" hasn’t been rehydrated onto the"},{"type":"text","text":" "},{"text":"request struct yet). Only then do we fall back to the key-material signal: a DPoP","type":"text"},{"text":" ","type":"text"},{"text":"keypair already persisted for this scope in the Keychain.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Empty scope always returns "},{"code":"false","type":"codeVoice"},{"type":"text","text":" — an empty "},{"code":"SFOAuthCredentials.identifier","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"would collide with unrelated accounts’ key material."}]},{"type":"paragraph","inlineContent":[{"text":"Note: this gate is deliberately independent of ","type":"text"},{"type":"codeVoice","code":"SalesforceManager.shared.usesDPoP"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The global flag governs ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"new","type":"text"}]},{"text":" logins (whether to request DPoP-bound tokens); once a","type":"text"},{"text":" ","type":"text"},{"text":"credential is bound, every request for it carries a proof regardless of the flag.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","abstract":[{"text":"Gate deciding whether to attach a DPoP proof for ","type":"text"},{"code":"scope","type":"codeVoice"},{"text":".","type":"text"}],"metadata":{"externalID":"c:@M@SalesforceSDKCore@objc(cs)SFSDKDPoPRequestDecorator(cm)shouldAttachDPoPForScope:tokenType:","role":"symbol","navigatorTitle":[{"text":"+ ","kind":"tex