{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":"(shouldAttachDPoPForScope:tokenType:) "},{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shouldAttachDPoP"},{"kind":"text","text":"("},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tokenType"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?) -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An explicit "},{"code":"tokenType","type":"codeVoice"},{"type":"text","text":" is authoritative:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"tokenType == \"DPoP\""},{"text":" (case-insensitive, per RFC 6749 §5.1 \/ RFC 9449 §6.1) → attach.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"any other known type (e.g. ","type":"text"},{"type":"codeVoice","code":"\"Bearer\""},{"text":") → do ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" attach, and short-circuit","type":"text"},{"text":" ","type":"text"},{"text":"before any Keychain I\/O. This is what protects the DPoP→Bearer migration \/","type":"text"},{"text":" ","type":"text"},{"text":"Bearer re-auth path: a Bearer credential that reuses a scope still holding stale","type":"text"},{"text":" ","type":"text"},{"text":"DPoP key material must never get an unexpected proof.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"tokenType == nil","type":"codeVoice"},{"type":"text","text":" is the transition window between "},{"code":"\/authorize","type":"codeVoice"},{"type":"text","text":" and "},{"code":"\/token","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(and any refresh where the persisted "},{"code":"tokenType","type":"codeVoice"},{"type":"text","text":" hasn’t been rehydrated onto the"},{"type":"text","text":" "},{"type":"text","text":"request struct yet). Only then do we fall back to the key-material signal: a DPoP"},{"type":"text","text":" "},{"type":"text","text":"keypair already persisted for this scope in the Keychain."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Empty scope always returns "},{"code":"false","type":"codeVoice"},{"type":"text","text":" — an empty "},{"code":"SFOAuthCredentials.identifier","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"would collide with unrelated accounts’ key material."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note: this gate is deliberately independent of "},{"code":"SalesforceManager.shared.usesDPoP","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The global flag governs "},{"inlineContent":[{"text":"new","type":"text"}],"type":"emphasis"},{"type":"text","text":" logins (whether to request DPoP-bound tokens); once a"},{"type":"text","text":" "},{"type":"text","text":"credential is bound, every request for it carries a proof regardless of the flag."}]}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/salesforcesdkcore\/dpoprequestdecorator\/shouldattachdpop(scope:tokentype:)"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/salesforcesdkcore\/dpoprequestdecorator\/shouldattachdpop(scope:tokentype:)"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"type":"text","text":"Gate deciding whether to attach a DPoP proof for "},