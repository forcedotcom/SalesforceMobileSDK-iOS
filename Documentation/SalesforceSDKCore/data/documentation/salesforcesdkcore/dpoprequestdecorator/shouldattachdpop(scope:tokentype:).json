 ","type":"text"},{"text":"credential is bound, every request for it carries a proof regardless of the flag.","type":"text"}],"type":"paragraph"}]}],"metadata":{"externalID":"c:@M@SalesforceSDKCore@objc(cs)SFSDKDPoPRequestDecorator(cm)shouldAttachDPoPForScope:tokenType:","symbolKind":"method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shouldAttachDPoP"},{"kind":"text","text":"("},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tokenType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"roleHeading":"Type Method","modules":[{"name":"SalesforceSDKCore"}],"navigatorTitle":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"shouldAttachDPoPForScope:tokenType:"}],"role":"symbol","title":"shouldAttachDPoP(scope:tokenType:)"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPRequestDecorator\/shouldAttachDPoP(scope:tokenType:)"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Gate deciding whether to attach a DPoP proof for "},{"type":"codeVoice","code":"scope"},{"type":"text","text":"."}],"references":{"doc://com.salesforce.mobilesdk.SalesforceSDKCore/documentation/SalesforceSDKCore/DPoPRequestDecorator/shouldAttachDPoP(scope:tokenType:)":{"url":"\/documentation\/salesforcesdkcore\/dpoprequestdecorator\/shouldattachdpop(scope:tokentype:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"shouldAttachDPoP"},{"kind":"text"