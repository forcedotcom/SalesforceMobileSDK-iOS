dk.SalesforceSDKCore\/SH"],"type":"conformsTo"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache"},"hierarchy":{"paths":[["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"DPoPNonceCache","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DPoPNonceCache"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DPoPNonceCache"}],"roleHeading":"Class","modules":[{"name":"SalesforceSDKCore"}],"externalID":"c:@M@SalesforceSDKCore@objc(cs)SFSDKDPoPNonceCache","symbolKind":"class"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":"(SFSDKDPoPNonceCache) "},{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DPoPNonceCache"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"items":[{"content":[{"inlineContent":[{"text":"proactive ","type":"text"},{"type":"codeVoice","code":"DPoP-Nonce"},{"text":" harvest from token-endpoint responses (Salesforce only","type":"text"},{"text":" ","type":"text"},{"text":"emits nonces from the token endpoint — resource-server responses don’t carry","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DPoP-Nonce"},{"text":" on 2xx or on challenges).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reactive 400 \/ 401 challenges at the token endpoint (RFC 9449 §8)."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Read semantics (","type":"text"},{"type":"codeVoice","code":"nonce(htu:scope:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"latest(forScope:)"},{"type":"text","text":") are intentionally"},{"type":"text","text":" "},{"type":"text","text":"non-destructive: the cache returns the most recently observed nonce and does NOT"},{"type":"text","text":" "},{"type":"text","text":"invalidate it on read. Rationale:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Per RFC 9449 §9, a server-issued nonce is reusable until the server rotates it."},{"type":"text","text":" "},{"type":"text","text":"Read-and-remove would force concurrent callers to race for a single nonce."},{"text":" ","type":"text"},{"text":"The non-destructive read lets every concurrent caller use the most recently","type":"text"},{"text":" ","type":"text"},{"text":"harvested value.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Resource-server calls reuse the latest token-endpoint nonce via"},{"text":" ","type":"text"},{"type":"codeVoice","code":"latest(forScope:)"},{"text":". When the access token’s nonce ages out, the next refresh","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(driven by the existing 401-on-resource → refresh-on-token → retry-resource"},{"type":"text","text":" "},{"text":"path) hits the token endpoint and harvests a fresh nonce on the way back, so","type":"text"},{"text":" ","type":"text"},{"text":"the retried resource-server call picks up the new value.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When the server rotates the nonce mid-flight, harvest from the in-flight"},{"type":"text","text":" "},{"type":"text","text":"response wins over harvest from a stale response that lost the race;"},{"type":"text","text":" "},{"type":"text","text":"last-writer-wins is acceptable because both values are server-issued."}],"type":"paragraph"}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/salesforcesdkcore\/dpopnoncecache"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/salesforcesdkcore\/dpopnoncecache"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.salesforce.mobilesdk.SalesforceSDKCore/documentation/SalesforceSDKCore/DPoPNonceCache/setNonce(_:htu:scope:)":{"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setNonce","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"htu","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":", ","kind":"text"},{"text":"scope","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?)","kind":"text"}],"title":"setNonce(_:htu:scope:)","abstract":[],"navigatorTitle":[{"text":"- ","kind":"text"},{"text":"setNonce:htu:scope:","kind":"identifier"}],"identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/setNonce(_:htu:scope:)","type":"topic","url":"\/documentation\/salesforcesdkcore\/dpopnoncecache\/setnonce(_:htu:scope:)","kind":"symbol"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/objc(cs)NSObject":{"identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/objc(cs)NSObject","type":"unresolvable","title":"NSObject"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/documentation/SalesforceSDKCore/DPoPNonceCache/shared":{"title":"shared","type":"topic","kind":"symbol","abstract":[],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"shared"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@M@SalesforceSDKCore@objc(cs)SFSDKDPoPNonceCache","kind":"typeIdentifier","text":"DPoPNonceCache"}],"identi