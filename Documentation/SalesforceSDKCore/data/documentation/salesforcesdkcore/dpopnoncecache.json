{"identifier":{"url":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache","interfaceLanguage":"swift"},"abstract":[{"text":"Process-lifetime cache of ","type":"text"},{"type":"codeVoice","code":"DPoP-Nonce"},{"text":" values, keyed by ","type":"text"},{"type":"codeVoice","code":"(htu, scope)"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"scope"},{"text":" is typically ","type":"text"},{"type":"codeVoice","code":"SFOAuthCredentials.identifier"},{"text":". Fed by:","type":"text"}],"metadata":{"roleHeading":"Class","externalID":"c:@M@SalesforceSDKCore@objc(cs)SFSDKDPoPNonceCache","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DPoPNonceCache","kind":"identifier"}],"role":"symbol","title":"DPoPNonceCache","navigatorTitle":[{"text":"DPoPNonceCache","kind":"identifier"}],"modules":[{"name":"SalesforceSDKCore"}],"symbolKind":"class"},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/objc(cs)NSObject"],"kind":"relationships","type":"inheritsFrom","title":"Inherits From"},{"identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/objc(pl)NSObject","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s7CVarArgP","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s28CustomDebugStringConvertibleP","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s23CustomStringConvertibleP","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/SQ","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/SH"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/salesforcesdkcore\/dpopnoncecache"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/salesforcesdkcore\/dpopnoncecache"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":"(SFSDKDPoPNonceCache) ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DPoPNonceCache","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"proactive "},{"type":"codeVoice","code":"DPoP-Nonce"},{"type":"text","text":" harvest from token-endpoint responses (Salesforce only"},{"type":"text","text":" "},{"type":"text","text":"emits nonces from the token endpoint — resource-server responses don’t carry"},{"type":"text","text":" "},{"type":"codeVoice","code":"DPoP-Nonce"},{"type":"text","text":" on 2xx or on challenges)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"reactive 400 \/ 401 challenges at the token endpoint (RFC 9449 §8).","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Read semantics (","type":"text"},{"code":"nonce(htu:scope:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"latest(forScope:)","type":"codeVoice"},{"text":") are intentionally","type":"text"},{"text":" ","type":"text"},{"text":"non-destructive: the cache returns the most recently observed nonce and does NOT","type":"text"},{"text":" ","type":"text"},{"text":"invalidate it on read. Rationale:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Per RFC 9449 §9, a server-issued nonce is reusable until the server rotates it."},{"type":"text","text":" "},{"type":"text","text":"Read-and-remove would force concurrent callers to race for a single nonce."},{"type":"text","text":" "},{"type":"text","text":"The non-destructive read lets every concurrent caller use the most recently"},{"type":"text","text":" "},{"type":"text","text":"harvested value."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Resource-server calls reuse the latest token-endpoint nonce via","type":"text"},{"text":" ","type":"text"},{"code":"latest(forScope:)","type":"codeVoice"},{"text":". When the access token’s nonce ages out, the next refresh","type":"text"},{"text":" ","type":"text"},{"text":"(driven by the existing 401-on-resource → refresh-on-token → retry-resource","type":"text"},{"text":" ","type":"text"},{"text":"path) hits the token endpoint and harvests a fresh nonce on the way back, so","type":"text"},{"text":" ","type":"text"},{"text":"the retried resource-server call picks up the new value.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"When the server rotates the nonce mid-flight, harvest from the in-flight"},{"type":"text","text":" "},{"type":"text","text":"response wins over harvest from a stale response that lost the race;"},{"type":"text","text":" "},{"type":"text","text":"last-writer-wins is acceptable because both values are server-issued."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/clear(forScope:)","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/clearAll()","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/latest(forScope:)","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/nonce(htu:scope:)","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/setNonce(_:htu:scope:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/com.salesforce.