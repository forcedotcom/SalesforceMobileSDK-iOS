{"identifier":{"url":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Process-lifetime cache of ","type":"text"},{"code":"DPoP-Nonce","type":"codeVoice"},{"text":" values, keyed by ","type":"text"},{"type":"codeVoice","code":"(htu, scope)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"scope"},{"type":"text","text":" is typically "},{"type":"codeVoice","code":"SFOAuthCredentials.identifier"},{"type":"text","text":". Fed by:"}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":"(SFSDKDPoPNonceCache) "},{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DPoPNonceCache"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"proactive "},{"type":"codeVoice","code":"DPoP-Nonce"},{"type":"text","text":" harvest from token-endpoint responses (Salesforce only"},{"type":"text","text":" "},{"type":"text","text":"emits nonces from the token endpoint — resource-server responses don’t carry"},{"type":"text","text":" "},{"type":"codeVoice","code":"DPoP-Nonce"},{"type":"text","text":" on 2xx or on challenges)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reactive 400 \/ 401 challenges at the token endpoint (RFC 9449 §8)."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read semantics ("},{"type":"codeVoice","code":"nonce(htu:scope:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"latest(forScope:)"},{"type":"text","text":") are intentionally"},{"type":"text","text":" "},{"type":"text","text":"non-destructive: the cache returns the most recently observed nonce and does NOT"},{"type":"text","text":" "},{"type":"text","text":"invalidate it on read. Rationale:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Per RFC 9449 §9, a server-issued nonce is reusable until the server rotates it."},{"type":"text","text":" "},{"type":"text","text":"Read-and-remove would force concurrent callers to race for a single nonce."},{"type":"text","text":" "},{"type":"text","text":"The non-destructive read lets every concurrent caller use the most recently"},{"type":"text","text":" "},{"type":"text","text":"harvested value."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Resource-server calls reuse the latest token-endpoint nonce via"},{"type":"text","text":" "},{"type":"codeVoice","code":"latest(forScope:)"},{"type":"text","text":". When the access token’s nonce ages out, the next refresh"},{"type":"text","text":" "},{"type":"text","text":"(driven by the existing 401-on-resource → refresh-on-token → retry-resource"},{"type":"text","text":" "},{"type":"text","text":"path) hits the token endpoint and harvests a fresh nonce on the way back, so"},{"type":"text","text":" "},{"type":"text","text":"the retried resource-server call picks up the new value."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When the server rotates the nonce mid-flight, harvest from the in-flight"},{"type":"text","text":" "},{"type":"text","text":"response wins over harvest from a stale response that lost the race;"},{"type":"text","text":" "},{"type":"text","text":"last-writer-wins is acceptable because both values are server-issued."}],"type":"paragraph"}]}]}]}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/clear(forScope:)","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documen