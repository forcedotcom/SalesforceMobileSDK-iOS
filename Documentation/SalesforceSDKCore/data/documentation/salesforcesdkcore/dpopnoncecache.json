salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/nonce(htu:scope:)","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/setNonce(_:htu:scope:)"],"title":"Instance Methods","anchor":"Instance-Methods"},{"generated":true,"identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/shared"],"title":"Type Properties","anchor":"Type-Properties"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":"(SFSDKDPoPNonceCache) ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DPoPNonceCache","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"proactive "},{"type":"codeVoice","code":"DPoP-Nonce"},{"type":"text","text":" harvest from token-endpoint responses (Salesforce only"},{"type":"text","text":" "},{"type":"text","text":"emits nonces from the token endpoint — resource-server responses don’t carry"},{"type":"text","text":" "},{"type":"codeVoice","code":"DPoP-Nonce"},{"type":"text","text":" on 2xx or on challenges)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"reactive 400 \/ 401 challenges at the token endpoint (RFC 9449 §8)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Read semantics (","type":"text"},{"type":"codeVoice","code":"nonce(htu:scope:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"latest(forScope:)"},{"text":") are intentionally","type":"text"},{"text":" ","type":"text"},{"text":"non-destructive: the cache returns the most recently observed nonce and does NOT","type":"text"},{"text":" ","type":"text"},{"text":"invalidate it on read. Rationale:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Per RFC 9449 §9, a server-issued nonce is reusable until the server rotates it."},{"type":"text","text":" "},{"type":"text","text":"Read-and-remove would force concurrent callers to race for a single nonce."},{"type":"text","text":" "},{"type":"text","text":"The non-destructive read lets every concurrent caller use the most recently"},{"type":"text","text":" "},{"type":"text","text":"harvested value."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Resource-server calls reuse the latest token-endpoint nonce via"},{"type":"text","text":" "},{"type":"codeVoice","code":"latest(forScope:)"},{"type":"text","text":". When the access token’s nonce ages out, the next refresh"},{"type":"text","text":" "},{"type":"text","text":"(driven by the existing 401-on-resource → refresh-on-token → retry-resource"},{"type":"text","text":" "},{"type":"text","text":"path) hits the token endpoint and harvests a fresh nonce on the way back, so"},{"type":"text","text":" "},{"type":"text","text":"the retried resource-server call picks up the new value."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When the server rotates the nonce mid-flight, harvest from the in-flight"},{"type":"text","text":" "},{"type":"text","text":"response wins over harvest from a stale response that lost the race;"},{"type":"text","text":" "},{"type":"text","text":"last-writer-wins is acceptable because both values are server-issued."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"abstract":[{"type":"text","text":"Process-lifetime cache of "},{"type":"codeVoice","code":"DPoP-Nonce"},{"type":"text","text":" values, keyed by "},{"type":"codeVoice","code":"(htu, scope)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"scope"},{"type":"text","text":" is typically "},{"type":"codeVoice","code":"SFOAuthCredentials.identifier"},{"type":"text","text":". Fed by:"}],"references":{"doc://com.salesforce.mobilesdk.SalesforceSDKCore/s28CustomDebugStringConvertibleP":{"type":"unresolvable","title":"Swift.CustomDebugStringConvertible","identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s28CustomDebugStringConvertibleP"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/documentation/SalesforceSDKCore/DPoPNonceCache/nonce(htu:scope:)":{"url":"\/documentation\/salesforcesdkcore\/dpopnoncecache\/nonce(htu:scope:)","kind":"symbol","identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/nonce(htu:scope:)","title":"nonce(htu:scope:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"nonce"},{"kind":"text","text":"("},{"kind":"externalParam","text":"htu"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"URL","preciseIdentifier":"s:10Foundation3URLV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"scope"},{"kind":"text","text":": "},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?) -> ","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"abstract":[{"text":"Returns the most recently observed nonce for ","type":"text"},{"type":"codeVoice","code":"(htu, scope)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if none."},{"type":"text","text":" "},{"type":"text","text":"Non-destructive — see class doc comment for rationale."}],"navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"nonceForHtu:scope:"}]},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/com.salesforce.mobilesdk.Salesforc