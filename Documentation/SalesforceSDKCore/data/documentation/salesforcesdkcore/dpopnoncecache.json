":"DPoPNonceCache","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"DPoPNonceCache"}]},"sections":[],"kind":"symbol","relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/objc(cs)NSObject"],"kind":"relationships","type":"inheritsFrom"},{"title":"Conforms To","identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/objc(pl)NSObject","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s7CVarArgP","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s28CustomDebugStringConvertibleP","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s23CustomStringConvertibleP","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/SQ","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/SH"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":"(SFSDKDPoPNonceCache) ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DPoPNonceCache","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"proactive "},{"type":"codeVoice","code":"DPoP-Nonce"},{"type":"text","text":" harvest from token-endpoint responses (Salesforce only"},{"type":"text","text":" "},{"type":"text","text":"emits nonces from the token endpoint — resource-server responses don’t carry"},{"type":"text","text":" "},{"type":"codeVoice","code":"DPoP-Nonce"},{"type":"text","text":" on 2xx or on challenges)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reactive 400 \/ 401 challenges at the token endpoint (RFC 9449 §8)."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Read semantics (","type":"text"},{"type":"codeVoice","code":"nonce(htu:scope:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"latest(forScope:)"},{"text":") are intentionally","type":"text"},{"text":" ","type":"text"},{"text":"non-destructive: the cache returns the most recently observed nonce and does NOT","type":"text"},{"text":" ","type":"text"},{"text":"invalidate it on read. Rationale:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Per RFC 9449 §9, a server-issued nonce is reusable until the server rotates it."},{"type":"text","text":" "},{"type":"text","text":"Read-and-remove would force concurrent callers to race for a single nonce."},{"type":"text","text":" "},{"type":"text","text":"The non-destructive read lets every concurrent caller use the most recently"},{"type":"text","text":" "},{"type":"text","text":"harvested value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Resource-server calls reuse the latest token-endpoint nonce via"},{"type":"text","text":" "},{"type":"codeVoice","code":"latest(forScope:)"},{"type":"text","text":". When the access token’s nonce ages out, the next refresh"},{"type":"text","text":" "},{"type":"text","text":"(driven by the existing 401-on-resource → refresh-on-token → retry-resource"},{"type":"text","text":" "},{"type":"text","text":"path) hits the token endpoint and harvests a fresh nonce on the way back, so"},{"type":"text","text":" "},{"type":"text","text":"the retried resource-server call picks up the new value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the server rotates the nonce mid-flight, harvest from the in-flight"},{"type":"text","text":" "},{"type":"text","text":"response wins over harvest from a stale response that lost the race;"},{"type":"text","text":" "},{"type":"text","text":"last-writer-wins is acceptable because both values are server-issued."}]}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache","interfaceLanguage":"swift"},"references":{"doc://com.salesforce.mobilesdk.SalesforceSDKCore/documentation/SalesforceSDKCore/DPoPNonceCache/clearAll()":{"navigatorTitle":[{"text":"- ","kind":"text"},{"text":"clearAll","kind":"identifier"}],"title":"clearAll()","abstract":[],"kind":"symbol","url":"\/documentation\/salesforcesdkcore\/dpopnoncecache\/clearall()","type":"topic","identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/clearAll()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearAll","kind":"identifier"},{"text":"()","kind":"text"}]},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/objc(cs)NSObject":{"type":"unresolvable","title":"NSObject","identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/objc(cs)NSObject"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/SH":{"identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/SQ":{"identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/s28CustomDebugStringConvertibleP":{"type":"unresolvable","title":"Swift.CustomDebugStringConvertible","identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s28CustomDebugStringConvertibleP"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/s7CVarArgP":{"type":"unresolvable","title":"Swift.CVarArg","identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s7CVarArgP"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/documentation/SalesforceSDKCore/DPoPNonceCache/nonce(htu:scope:)":{"navigatorTitle":[{"kind":"text","text":"- "},{"text":"nonceForHtu:scope:","kind":"identifier"}],"title":