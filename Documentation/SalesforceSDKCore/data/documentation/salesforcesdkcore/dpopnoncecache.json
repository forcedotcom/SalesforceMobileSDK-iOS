{"identifier":{"url":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache","interfaceLanguage":"swift"},"metadata":{"role":"symbol","title":"DPoPNonceCache","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DPoPNonceCache"}],"modules":[{"name":"SalesforceSDKCore"}],"symbolKind":"class","roleHeading":"Class","externalID":"c:@M@SalesforceSDKCore@objc(cs)SFSDKDPoPNonceCache","navigatorTitle":[{"kind":"identifier","text":"DPoPNonceCache"}]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"text":"(SFSDKDPoPNonceCache) ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"DPoPNonceCache"}]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"proactive "},{"type":"codeVoice","code":"DPoP-Nonce"},{"type":"text","text":" harvest from token-endpoint responses (Salesforce only"},{"type":"text","text":" "},{"type":"text","text":"emits nonces from the token endpoint — resource-server responses don’t carry"},{"type":"text","text":" "},{"type":"codeVoice","code":"DPoP-Nonce"},{"type":"text","text":" on 2xx or on challenges)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"reactive 400 \/ 401 challenges at the token endpoint (RFC 9449 §8)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Read semantics ("},{"type":"codeVoice","code":"nonce(htu:scope:)"},{"type":"text","text":", "},{"code":"latest(forScope:)","type":"codeVoice"},{"type":"text","text":") are intentionally"},{"type":"text","text":" "},{"type":"text","text":"non-destructive: the cache returns the most recently observed nonce and does NOT"},{"type":"text","text":" "},{"type":"text","text":"invalidate it on read. Rationale:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Per RFC 9449 §9, a server-issued nonce is reusable until the server rotates it."},{"type":"text","text":" "},{"type":"text","text":"Read-and-remove would force concurrent callers to race for a single nonce."},{"type":"text","text":" "},{"type":"text","text":"The non-destructive read lets every concurrent caller use the most recently"},{"type":"text","text":" "},{"type":"text","text":"harvested value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Resource-server calls reuse the latest token-endpoint nonce via"},{"type":"text","text":" "},{"code":"latest(forScope:)","type":"codeVoice"},{"type":"text","text":". When the access token’s nonce ages out, the next refresh"},{"type":"text","text":" "},{"type":"text","text":"(driven by the existing 401-on-resource → refresh-on-token → retry-resource"},{"type":"text","text":" "},{"type":"text","text":"path) hits the token endpoint and harvests a fresh nonce on the way back, so"},{"type":"text","text":" "},{"type":"text","text":"the retried resource-server call picks up the new value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the server rotates the nonce mid-flight, harvest from the in-flight"},{"type":"text","text":" "},{"type":"text","text":"response wins over harvest from a stale response that lost the race;"},{"type":"text","text":" "},{"type":"text","text":"last-writer-wins is acceptable because both values are server-issued."}]}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore"]]},"topicSections":[{"identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/clear(for