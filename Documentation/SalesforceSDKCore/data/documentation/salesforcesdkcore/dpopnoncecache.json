DKCore\/documentation\/SalesforceSDKCore"]]},"kind":"symbol","topicSections":[{"generated":true,"identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/clear(forScope:)","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/clearAll()","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/latest(forScope:)","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/nonce(htu:scope:)","doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/setNonce(_:htu:scope:)"],"anchor":"Instance-Methods","title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/shared"],"anchor":"Type-Properties","title":"Type Properties"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@objc","kind":"attribute"},{"text":"(SFSDKDPoPNonceCache) ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DPoPNonceCache","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"proactive ","type":"text"},{"type":"codeVoice","code":"DPoP-Nonce"},{"text":" harvest from token-endpoint responses (Salesforce only","type":"text"},{"text":" ","type":"text"},{"text":"emits nonces from the token endpoint — resource-server responses don’t carry","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DPoP-Nonce"},{"text":" on 2xx or on challenges).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"reactive 400 \/ 401 challenges at the token endpoint (RFC 9449 §8).","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read semantics ("},{"type":"codeVoice","code":"nonce(htu:scope:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"latest(forScope:)"},{"type":"text","text":") are intentionally"},{"type":"text","text":" "},{"type":"text","text":"non-destructive: the cache returns the most recently observed nonce and does NOT"},{"type":"text","text":" "},{"type":"text","text":"invalidate it on read. Rationale:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Per RFC 9449 §9, a server-issued nonce is reusable until the server rotates it.","type":"text"},{"text":" ","type":"text"},{"text":"Read-and-remove would force concurrent callers to race for a single nonce.","type":"text"},{"text":" ","type":"text"},{"text":"The non-destructive read lets every concurrent caller use the most recently","type":"text"},{"text":" ","type":"text"},{"text":"harvested value.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Resource-server calls reuse the latest token-endpoint nonce via","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"latest(forScope:)"},{"text":". When the access token’s nonce ages out, the next refresh","type":"text"},{"text":" ","type":"text"},{"text":"(driven by the existing 401-on-resource → refresh-on-token → retry-resource","type":"text"},{"text":" ","type":"text"},{"text":"path) hits the token endpoint and harvests a fresh nonce on the way back, so","type":"text"},{"text":" ","type":"text"},{"text":"the retried resource-server call picks up the new value.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When the server rotates the nonce mid-flight, harvest from the in-flight","type":"text"},{"text":" ","type":"text"},{"text":"response wins over harvest from a stale response that lost the race;","type":"text"},{"text":" ","type":"text"},{"text":"last-writer-wins is acceptable because both values are server-issued.","type":"text"}]}]}]}],"kind":"content"}],"references":{"doc://com.salesforce.mobilesdk.SalesforceSDKCore/documentation/SalesforceSDKCore/DPoPNonceCache/clearAll()":{"abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearAll","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic","identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/clearAll()","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"clearAll","kind":"identifier"}],"title":"clearAll()","url":"\/documentation\/salesforcesdkcore\/dpopnoncecache\/clearall()","role":"symbol","kind":"symbol"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/documentation/SalesforceSDKCore/DPoPNonceCache/clear(forScope:)":{"url":"\/documentation\/salesforcesdkcore\/dpopnoncecache\/clear(forscope:)","abstract":[],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clear","kind":"identifier"},{"text":"(","kind":"text"},{"text":"forScope","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","title":"clear(forScope:)","role":"symbol","identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/documentation\/SalesforceSDKCore\/DPoPNonceCache\/clear(forScope:)","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"clearForScope:","kind":"identifier"}]},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/s23CustomStringConvertibleP":{"type":"unresolvable","identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s23CustomStringConvertibleP","title":"Swift.CustomStringConvertible"},"doc://com.salesforce.mobilesdk.SalesforceSDKCore/s7CVarArgP":{"identifier":"doc:\/\/com.salesforce.mobilesdk.SalesforceSDKCore\/s7CVarArgP","type":"unre